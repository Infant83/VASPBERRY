*.f whitespace=trailing-space,space-before-tab,cr-at-eol
# Python csv writers emit RFC-style CRLF; retain exact reference checksums.
examples/features/**/reference/*.csv whitespace=trailing-space,space-before-tab,cr-at-eol
validation/models/**/reference/*.csv whitespace=trailing-space,space-before-tab,cr-at-eol
# Preserve native Fortran record padding and the exact archived output hashes.
examples/features/**/reference/*.dat -whitespace
examples/features/**/reference/*.log -whitespace
# Keep native VASP records and the archived Fukui output byte-for-byte.
examples/features/fukui-berry-curvature/inputs/POSCAR -whitespace
examples/features/fukui-berry-curvature/reference/archive/*.dat -whitespace
examples/features/fukui-berry-curvature/reference/archive/*.csv whitespace=trailing-space,space-before-tab,cr-at-eol
examples/features/fukui-berry-curvature/reference/python/*.csv whitespace=trailing-space,space-before-tab,cr-at-eol
examples/features/fukui-berry-curvature/reference/vasp/OUTCAR -whitespace
examples/features/fukui-berry-curvature/reference/vasp/EIGENVAL -whitespace
examples/features/fukui-berry-curvature/reference/vasp/OSZICAR -whitespace
# Preserve native VASP output and CSV line endings in the matching-path examples.
examples/features/fukui-berry-curvature/reference/path/OUTCAR -whitespace
examples/features/fukui-berry-curvature/reference/path/EIGENVAL -whitespace
examples/features/fukui-berry-curvature/reference/path/OSZICAR -whitespace
examples/features/**/reference/path/*.csv whitespace=trailing-space,space-before-tab,cr-at-eol
examples/features/**/reference/map-path/*.csv whitespace=trailing-space,space-before-tab,cr-at-eol
examples/Bi_Z2/WAVECAR filter=lfs diff=lfs merge=lfs -text

# Preserve new bundle CSV and local-valley native VASP records.
examples/features/**/reference/bundle/*.csv whitespace=trailing-space,space-before-tab,cr-at-eol
examples/features/**/reference/smooth/*.csv whitespace=trailing-space,space-before-tab,cr-at-eol
examples/features/kubo-curvature/valleys/reference/vasp/OUTCAR -whitespace
examples/features/kubo-curvature/valleys/reference/vasp/EIGENVAL -whitespace
examples/features/kubo-curvature/valleys/reference/vasp/OSZICAR -whitespace
