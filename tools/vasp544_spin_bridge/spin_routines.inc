! Original VASPBERRY opt-in instrumentation; no VASP implementation body.

  SUBROUTINE BSP_DOT(W0,W1,MAT,MODE)
    USE wave
    IMPLICIT NONE
    TYPE(wavespin) :: W0,W1
    COMPLEX(q) :: MAT(:,:,:,:)
    INTEGER MODE,NK,NG,NP
    TYPE(wavedes1) :: WD
    MAT=0
    DO NK=1,W0%WDES%NKPTS
      CALL SETWDES(W0%WDES,WD,NK)
      NG=WD%NPL;NP=WD%NPRO
      IF (MODE==0) MAT(:,:,NK,1)=MATMUL(TRANSPOSE(CONJG(W0%CW(1:NG,:,NK,1))),W1%CW(1:NG,:,NK,1))
      IF (MODE==1) MAT(:,:,NK,1)=MATMUL(TRANSPOSE(CONJG(W0%CPROJ(1:NP,:,NK,1))),W1%CPROJ(1:NP,:,NK,1))
    ENDDO
  END SUBROUTINE BSP_DOT

  SUBROUTINE BSP_INIT(W,LMDIM,CQIJ)
    USE wave
    IMPLICIT NONE
    TYPE(wavespin) :: W,WT
    TYPE(wavefun) :: TMP
    TYPE(wavedes1) :: WD
    INTEGER LMDIM,NB,NK,NG,NP,A
    OVERLAP CQIJ(LMDIM,LMDIM,W%WDES%NIONS,W%WDES%NCDIJ)
    IF (W%WDES%ISPIN/=1.OR.W%WDES%NRSPINORS/=2.OR.W%WDES%DO_REDIS) STOP 'BSP requires serial SOC spinors'
    IF (MAXVAL(ABS(W%WDES%SAXIS-(/0._q,0._q,1._q/)))>1E-12_q) STOP 'BSP requires Cartesian +z SAXIS'
    IF (MAXVAL(ABS(CQIJ(:,:,:,2)))>1E-12_q.OR.MAXVAL(ABS(CQIJ(:,:,:,3)))>1E-12_q.OR. &
        MAXVAL(ABS(CQIJ(:,:,:,1)-CQIJ(:,:,:,4)))>1E-12_q) STOP 'BSP requires spin-independent PAW overlap'
    NB=W%WDES%NB_TOT
    IF (REAL(NB,q)*NB*W%WDES%NKPTS*17*16>2E9_q) STOP 'BSP arrays exceed 2 GB budget'
    ALLOCATE(BSP_PSEUDO(NB,NB,W%WDES%NKPTS,1,4),BSP_DELTA(NB,NB,W%WDES%NKPTS,1,4))
    ALLOCATE(BSP_XI(NB,NB,W%WDES%NKPTS,1,3),BSP_T(NB,NB,W%WDES%NKPTS,1,3),BSP_V(NB,NB,W%WDES%NKPTS,1,3))
    BSP_XI=0;BSP_T=0;BSP_V=0
    CALL ALLOCW(W%WDES,WT,TMP,TMP)
    DO A=1,4
      WT%CW=W%CW;WT%CPROJ=W%CPROJ
      DO NK=1,W%WDES%NKPTS
        CALL SETWDES(W%WDES,WD,NK)
        NG=WD%NGVECTOR;NP=WD%NPRO/2
        SELECT CASE(A)
        CASE(2)
          WT%CW(1:NG,:,NK,1)=W%CW(NG+1:2*NG,:,NK,1)
          WT%CW(NG+1:2*NG,:,NK,1)=W%CW(1:NG,:,NK,1)
          WT%CPROJ(1:NP,:,NK,1)=W%CPROJ(NP+1:2*NP,:,NK,1)
          WT%CPROJ(NP+1:2*NP,:,NK,1)=W%CPROJ(1:NP,:,NK,1)
        CASE(3)
          WT%CW(1:NG,:,NK,1)=(0._q,-1._q)*W%CW(NG+1:2*NG,:,NK,1)
          WT%CW(NG+1:2*NG,:,NK,1)=(0._q,1._q)*W%CW(1:NG,:,NK,1)
          WT%CPROJ(1:NP,:,NK,1)=(0._q,-1._q)*W%CPROJ(NP+1:2*NP,:,NK,1)
          WT%CPROJ(NP+1:2*NP,:,NK,1)=(0._q,1._q)*W%CPROJ(1:NP,:,NK,1)
        CASE(4)
          WT%CW(NG+1:2*NG,:,NK,1)=-W%CW(NG+1:2*NG,:,NK,1)
          WT%CPROJ(NP+1:2*NP,:,NK,1)=-W%CPROJ(NP+1:2*NP,:,NK,1)
        END SELECT
      ENDDO
      CALL BSP_DOT(W,WT,BSP_PSEUDO(:,:,:,:,A),0)
      CALL OVERL_ALL(W%WDES,WT,WT,.TRUE.,LMDIM,CQIJ)
      CALL BSP_DOT(W,WT,BSP_DELTA(:,:,:,:,A),1)
    ENDDO
    CALL DEALLOCW(WT)
  END SUBROUTINE BSP_INIT

  SUBROUTINE BSP_RAW(W,WXI,IDIR)
    USE wave
    IMPLICIT NONE
    TYPE(wavespin) :: W,WXI
    INTEGER IDIR,NK,N
    CALL BSP_DOT(W,WXI,BSP_XI(:,:,:,:,IDIR),0)
    DO NK=1,W%WDES%NKPTS
      DO N=1,W%WDES%NB_TOT
        BSP_XI(:,N,NK,1,IDIR)=BSP_XI(:,N,NK,1,IDIR)+WXI%CELTOT(N,NK,1)* &
          (BSP_PSEUDO(:,N,NK,1,1)+BSP_DELTA(:,N,NK,1,1))
      ENDDO
    ENDDO
  END SUBROUTINE BSP_RAW

  SUBROUTINE BSP_CORRECTION(W,WXI,LMDIM,CQIJ,CDIJ1,IDIR)
    USE wave
    IMPLICIT NONE
    TYPE(wavespin) :: W,WXI,WT
    TYPE(wavefun) :: TMP
    INTEGER LMDIM,IDIR,NK,N,M
    OVERLAP CQIJ(LMDIM,LMDIM,W%WDES%NIONS,W%WDES%NCDIJ),CDIJ1(LMDIM,LMDIM,W%WDES%NIONS,W%WDES%NCDIJ)
    REAL(q) GAP
    CALL ALLOCW(W%WDES,WT,TMP,TMP)
    WT%CW=0;WT%CPROJ=WXI%CPROJ
    CALL OVERL_ALL(W%WDES,WT,WT,.TRUE.,LMDIM,CQIJ)
    CALL OVERL_ALL(W%WDES,W,WT,.FALSE.,LMDIM,CDIJ1)
    CALL BSP_DOT(W,WT,BSP_T(:,:,:,:,IDIR),1)
    DO NK=1,W%WDES%NKPTS
      DO N=1,W%WDES%NB_TOT
        DO M=1,W%WDES%NB_TOT
          GAP=REAL(W%CELTOT(N,NK,1)-W%CELTOT(M,NK,1),q)
          BSP_V(M,N,NK,1,IDIR)=(0._q,1._q)*(BSP_XI(M,N,NK,1,IDIR)+GAP*BSP_T(M,N,NK,1,IDIR))
        ENDDO
      ENDDO
    ENDDO
    CALL DEALLOCW(WT)
  END SUBROUTINE BSP_CORRECTION

  SUBROUTINE BSP_WRITE(W,LATT_CUR,EFERMI)
    USE wave
    USE lattice
    USE constant
    IMPLICIT NONE
    TYPE(wavespin) :: W
    TYPE(latt) :: LATT_CUR
    REAL(q) EFERMI
    INTEGER IU,IERR
    INTEGER(KIND=4) HEAD(7)
    CHARACTER(LEN=32) MAGIC,FOOTER
    MAGIC='VBERRY_PAW_SPIN_VELOCITY_V1'
    FOOTER='VBERRY_SPIN_VELOCITY_COMPLETE_V1'
    HEAD=(/1,W%WDES%NKPTS,W%WDES%NB_TOT,1,3,8,16/)
    OPEN(NEWUNIT=IU,FILE='SPIN_VELOCITY.bin',ACCESS='STREAM',FORM='UNFORMATTED',STATUS='NEW',IOSTAT=IERR)
    IF (IERR/=0) STOP 'BSP output already exists or cannot open'
    WRITE(IU,IOSTAT=IERR) MAGIC,HEAD,EFERMI,LATT_CUR%A,LATT_CUR%B*TPI,W%WDES%VKPT,W%WDES%WTKPT, &
       REAL(W%CELTOT,q),W%FERTOT,BSP_PSEUDO,BSP_DELTA,BSP_XI,BSP_T,BSP_V,FOOTER
    IF (IERR/=0) STOP 'BSP write failed'
    CLOSE(IU,IOSTAT=IERR)
    IF (IERR/=0) STOP 'BSP close failed'
    WRITE(*,*) 'VASPBERRY: completed SPIN_VELOCITY.bin'
  END SUBROUTINE BSP_WRITE
